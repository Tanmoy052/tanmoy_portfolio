{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://tanmoy-portfolio-pp93.onrender.com/api/$1"
    },
    {
      "source": "/documents/(.*)",
      "destination": "https://tanmoy-portfolio-pp93.onrender.com/documents/$1"
    },
    {
      "source": "/((?!api|assets|documents|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
